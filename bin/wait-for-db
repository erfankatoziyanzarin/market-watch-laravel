#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
socket_path="$project_dir/storage/mysql.sock"

for ((attempt = 0; attempt < 40; attempt++)); do
    if mysqladmin --socket="$socket_path" -u root ping >/dev/null 2>&1; then
        exit 0
    fi
    sleep 1
done

echo 'Local MySQL did not become ready within 40 seconds.' >&2
exit 1
